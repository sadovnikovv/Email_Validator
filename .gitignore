# =========================
# Python (based on GitHub Python.gitignore)
# =========================
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
ENV/
env/

# PyInstaller
*.manifest
*.spec

# Unit test / coverage
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.pytest_cache/

# Jupyter
.ipynb_checkpoints

# Logs
*.log

# =========================
# IDEs / editors
# =========================
# PyCharm / IntelliJ
.idea/          # ignore .idea folder [web:35][web:44]

# VS Code
.vscode/

# =========================
# OS / Windows
# =========================
Thumbs.db
Desktop.ini

# =========================
# Project-specific
# =========================
# Results produced by validator
results/

# Input files (обычно с персональными данными)
emails+1.xlsx
*.xlsx

# Env files
.env
.env.*